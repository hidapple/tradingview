//@version=6
indicator("Stage Analysis", shorttitle="Stage", overlay=true)

// ---------- Inputs ----------
ma_length = input.int(30, "MA length (weeks)", minval=1, group="Stage Definition")
slope_lookback = input.int(5, "Slope lookback (weeks)", minval=1, group="Stage Definition",
     tooltip="The MA slope is the % change of the MA over this many weeks, divided by the same number to get % per week")
flat_threshold = input.float(0.2, "Flat threshold (% per week)", minval=0.0, step=0.05, group="Stage Definition",
     tooltip="The MA is rising above +threshold, falling below -threshold and flat in between")
confirm_weeks = input.int(2, "Confirmation (weeks)", minval=1, group="Stage Definition",
     tooltip="MA-based stage changes are confirmed only after the new stage's condition holds for this many consecutive weeks. Range breakouts apply immediately")

min_base_weeks = input.int(3, "Min base length (weeks)", minval=1, group="Range Breakout",
     tooltip="A Stage 1/3 range must be at least this many weeks old before a breakout from it counts")
breakout_vol_mult = input.float(1.5, "Breakout volume multiplier", minval=1.0, step=0.1, group="Range Breakout",
     tooltip="An upside breakout week needs volume above the prior 10-week average volume times this multiplier. Downside breakouts need no volume")
seed_lookback = input.int(10, "Range seed lookback (weeks)", minval=1, group="Range Breakout",
     tooltip="When Stage 1 starts, its range low starts from the lowest low of this many weeks (Stage 3: range high from the highest high), so the bottom (top) of the prior trend belongs to the base")

show_ma = input.bool(false, "Show stage MA", group="Display")
stage2_color = input.color(color.new(color.green, 90), "Stage 2 background", group="Display")
stage3_color = input.color(color.new(color.yellow, 85), "Stage 3 background", group="Display")
stage4_color = input.color(color.new(color.red, 90), "Stage 4 background", group="Display")

// ---------- Stage state machine (evaluated on weekly bars) ----------
// The in-progress week is included, so on realtime bars the stage can change intraweek.
// Stage 1/3 end with a close outside their range (applied immediately), Stage 2/4 end when
// the MA slope leaves the rising/falling zone or price stays across the MA (confirmed over several weeks).
f_stage(simple int len, simple int n, simple float thr, simple int confirm, simple int min_base, simple float vol_mult, simple int seed) =>
    ma = ta.sma(close, len)
    slope = (ma - ma[n]) / ma[n] * 100 / n
    high_52w = ta.highest(high, 52)
    low_52w = ta.lowest(low, 52)
    avg_vol = ta.sma(volume, 10)[1]
    vol_ratio = volume / avg_vol
    seed_high = ta.highest(high, seed)
    seed_low = ta.lowest(low, seed)
    recent_high = ta.highest(high, confirm)
    recent_low = ta.lowest(low, confirm)

    var int stage = na
    var bool matured = false      // the MA reached the rising/falling zone during the current Stage 2/4
    var int pending = na          // slope-based candidate stage waiting for confirmation
    var int pending_count = 0
    var int weeks_in_stage = 0
    var float range_high = na     // highest high since the current stage started
    var float range_low = na      // lowest low since the current stage started
    var int origin = na           // stage before the current one
    // Last Stage 1/3 base, restored when a breakout from it fails
    var float base_high = na
    var float base_low = na
    var int base_weeks = 0
    var int base_origin = na

    if not na(slope) and not na(high_52w)
        above = close > ma
        below = close < ma
        rising = slope > thr
        falling = slope < -thr
        new_stage = stage
        if na(stage)
            // No history yet: strong trends map directly, otherwise use the position in the 52-week range
            new_stage := above and rising ? 2 : below and falling ? 4 : close >= (high_52w + low_52w) / 2 ? 3 : 1
        else
            if (stage == 2 and rising) or (stage == 4 and falling)
                matured := true

            // Range breakouts from Stage 1/3, compared against the range of the prior weeks.
            // Symbols without volume data (e.g. indices) skip the volume check.
            base_ready = (stage == 1 or stage == 3) and weeks_in_stage >= min_base
            vol_ok = na(avg_vol) or vol_ratio >= vol_mult
            breakout_up = base_ready and close > range_high and slope >= -thr and vol_ok
            breakout_down = base_ready and close < range_low and slope <= thr

            // MA-based transitions (confirmed over several weeks). Stage 1/3 -> 2 on a rising MA
            // is the fallback for advances that never produce a volume-backed breakout.
            // Stage 2/4 also end when price stays on the other side of the MA, even while the
            // MA itself still points in the trend direction (e.g. a sharp drop after a big run).
            // An immature Stage 2/4 that crosses back over the MA is a failed breakout/breakdown
            // and returns to the base it came from.
            failed_up_stage = origin == 3 ? 3 : 1
            failed_down_stage = origin == 1 ? 1 : 3
            candidate = switch stage
                1 => above and rising ? 2 : 1
                2 => below and falling ? 4 : below ? (matured ? 3 : failed_up_stage) : matured and not rising ? 3 : 2
                3 => above and rising ? 2 : 3
                => above and rising ? 2 : above ? (matured ? 1 : failed_down_stage) : matured and not falling ? 1 : 4

            if breakout_up
                new_stage := 2
            else if breakout_down
                new_stage := 4
            else if candidate != stage
                pending_count := candidate == pending ? pending_count + 1 : 1
                pending := candidate
                if pending_count >= confirm
                    new_stage := candidate
            else
                pending := na
                pending_count := 0

        if na(stage) or new_stage != stage
            failed_return = (stage == 2 or stage == 4) and not matured and new_stage == origin and not na(base_high)
            if failed_return
                // Back into the base: restore its range and age, extended by the failed move
                range_high := math.max(base_high, range_high, high)
                range_low := math.min(base_low, range_low, low)
                weeks_in_stage := base_weeks + weeks_in_stage
                origin := base_origin
            else
                if stage == 1 or stage == 3
                    base_high := range_high
                    base_low := range_low
                    base_weeks := weeks_in_stage
                    base_origin := origin
                // The confirmation weeks belong to the new stage. A new Stage 1 (3) also reaches
                // back to the low (high) of the prior trend.
                range_high := new_stage == 3 ? seed_high : recent_high
                range_low := new_stage == 1 ? seed_low : recent_low
                weeks_in_stage := 0
                origin := stage
            stage := new_stage
            matured := (stage == 2 and rising) or (stage == 4 and falling)
            pending := na
            pending_count := 0
        else
            range_high := math.max(range_high, high)
            range_low := math.min(range_low, low)
        weeks_in_stage += 1
    [stage, ma, slope, weeks_in_stage, vol_ratio]

[stage, stage_ma, ma_slope, weeks_in_stage, vol_ratio] = request.security(syminfo.tickerid, "W",
     f_stage(ma_length, slope_lookback, flat_threshold, confirm_weeks, min_base_weeks, breakout_vol_mult, seed_lookback))

// ---------- Display ----------
// Stage 1 keeps the normal chart background
bgcolor(stage == 2 ? stage2_color : stage == 3 ? stage3_color : stage == 4 ? stage4_color : na, title="Stage Background")
plot(show_ma ? stage_ma : na, title="Stage MA", color=color.rgb(255, 140, 0), linewidth=1)

// Values for the data window only
plot(stage, title="Stage", display=display.data_window)
plot(ma_slope, title="MA Slope %/W", display=display.data_window)
plot(weeks_in_stage, title="Weeks in Stage", display=display.data_window)
plot(vol_ratio, title="Weekly Volume Ratio", display=display.data_window)
