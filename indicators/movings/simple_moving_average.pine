//@version=6
indicator("Simple Moving Average", shorttitle = "SMA", overlay = true)

sma10 = ta.sma(close, 10)
sma21 = ta.sma(close, 21)
sma30 = ta.sma(close, 30)
sma50 = ta.sma(close, 50)
sma200 = ta.sma(close, 200)


// For Weekly
isWeekly = timeframe.period == "1W"
plot(isWeekly ? sma10 : na, title="SMA 10", color=color.rgb(255, 215, 0), linewidth=1)
plot(isWeekly ? sma30 : na, title="SMA 30", color=color.rgb(255, 140, 0), linewidth=1)
// For Others
plot(isWeekly ? na : sma10, title="SMA 10", color=color.rgb(0, 191, 255), linewidth=1)
plot(isWeekly ? na : sma21, title="SMA 21", color=color.rgb(50, 205, 50), linewidth=1)
plot(isWeekly ? na : sma50, title="SMA 50", color=color.rgb(255, 215, 0), linewidth=1)
plot(isWeekly ? na : sma200, title="SMA 200", color=color.rgb(220, 20, 60), linewidth=1)

// 52-week High/Low levels
lookback = isWeekly ? 52 : timeframe.ismonthly ? 12 : 252
high52w = ta.highest(high, lookback)
low52w = ta.lowest(low, lookback)
highBarsAgo = ta.highestbars(high, lookback)
lowBarsAgo = ta.lowestbars(low, lookback)

var line highLine = na
var line lowLine = na
var label highLabel = na
var label lowLabel = na

// Always show the current 52-week high/low: a thin dotted line anchored at the bar
// that set the extreme, extending right, with the price text at the right end
if barstate.islast
    line.delete(highLine)
    label.delete(highLabel)
    line.delete(lowLine)
    label.delete(lowLabel)
    if not na(high52w)
        highLine := line.new(bar_index + highBarsAgo, high52w, bar_index + 2, high52w, color=color.new(color.rgb(0, 155, 0), 40), style=line.style_dotted, width=1)
        highLabel := label.new(bar_index + 6, high52w, str.tostring(high52w, format.mintick), style=label.style_none, textcolor=color.rgb(0, 155, 0), size=size.small)
    if not na(low52w)
        lowLine := line.new(bar_index + lowBarsAgo, low52w, bar_index + 2, low52w, color=color.new(color.rgb(255, 82, 82), 40), style=line.style_dotted, width=1)
        lowLabel := label.new(bar_index + 6, low52w, str.tostring(low52w, format.mintick), style=label.style_none, textcolor=color.rgb(255, 82, 82), size=size.small)
